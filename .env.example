# ==============================================================================
# 🌐 PICOBOT 2.0 - ROOT ENVIRONMENT VARIABLES (EXAMPLE)
# ==============================================================================

# 1. 🗄️ DATABASE & ORM (Server-side Postgres connection for Drizzle)
DATABASE_URL="postgresql://user:password@host:port/database"

# 2. 🔐 SUPABASE (Client-side Auth/Realtime & Server-side Admin)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# 3. 🧠 AI PROVIDERS (Vercel AI SDK integration)
GEMINI_API_KEY="your-gemini-api-key"
ZAI_API_KEY="your-zai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

FIRECRAWL_API_KEY="your-firecrawl-api-key"
RESEND_API_KEY="your-resend-api-key"

# 4. ⚡ RATE LIMITING & CACHING (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# 5. 💳 BILLING (LemonSqueezy webhooks and API)
LEMONSQUEEZY_TEST_API_KEY="your-lemonsqueezy-test-key"
LEMONSQUEEZY_LIVE_API_KEY="your-lemonsqueezy-live-key"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-secret"
LEMONSQUEEZY_STORE_ID="your-store-id"
LEMONSQUEEZY_MODE="test" # or "live"

# 6. 🌍 APPLICATION URLs (CORS & Cross-App Linking)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_WIDGET_URL="http://localhost:5174"
NEXT_PUBLIC_MARKETING_URL="http://localhost:4321"
NEXT_PUBLIC_DOCS_URL="http://localhost:4322"

# 7. 🛠️ FEATURE FLAGS & SYSTEM CONFIG
NEXT_PUBLIC_SYSTEM_STATUS="live"
NEXT_PUBLIC_SYSTEM_DOWNTIME="~30 minutes"
NEXT_PUBLIC_IS_TEST_MODE="true"
