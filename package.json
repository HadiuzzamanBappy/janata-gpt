{
  "name": "picobot2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "git clean -xdf -e .env -e .env.local",
    "ui:update": "pnpm dlx shadcn@latest apply --preset bciyLJq4",
    "test:models": "node scripts/test/common/test-list-models.js",
    "test:limits": "node scripts/test/common/test-provider-limits.js",
    "test:zai": "node scripts/test/common/test-zai-local.js",
    "test:gemini": "node scripts/test/common/test-gemini-local.js",
    "db:login": "npx supabase login",
    "db:link": "npx supabase link --project-ref ftibzyymywczhttemwwu",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:studio": "npx supabase start && start http://localhost:54323",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:reset": "npx supabase db reset",
    "db:new": "npx supabase migration new",
    "db:status": "npx supabase migration list",
    "db:deploy": "npx supabase functions deploy",
    "db:types": "npx supabase gen types typescript --project-id ftibzyymywczhttemwwu > packages/types/src/supabase.ts",
    "version:patch": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1 patch",
    "version:minor": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1 minor",
    "version:major": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1 major",
    "seed:users": "node scripts/demo/seed-users.js",
    "seed:demo": "node scripts/demo/seed-demo-data.js"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "^2.117.0",
    "turbo": "^2.10.13",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.6.1"
    }
  }
}