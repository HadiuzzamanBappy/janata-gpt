{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/ui/*"
      ],
      "@/hooks/*": [
        "../../packages/ui/src/hooks/*"
      ],
      "@/lib/plugins": [
        "./src/lib/plugins"
      ],
      "@/lib/chats": [
        "./src/lib/chats"
      ],
      "@/lib/*": [
        "../../packages/ui/src/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}